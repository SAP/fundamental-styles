{
    "name": "mcp",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/mcp/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build-tsc": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "cache": true,
            "dependsOn": ["^build", "sync-entry"],
            "options": {
                "outputPath": "dist/packages/mcp",
                "tsConfig": "packages/mcp/tsconfig.lib.json",
                "packageJson": "packages/mcp/package.json",
                "main": "packages/mcp/src/index.ts",
                "assets": [
                    {
                        "input": "docs",
                        "glob": "*.json",
                        "output": "data"
                    },
                    {
                        "input": "docs",
                        "glob": "*.md",
                        "output": "data"
                    },
                    {
                        "input": "docs/schemas",
                        "glob": "*.schema.json",
                        "output": "data/schemas"
                    },
                    {
                        "input": "docs/components",
                        "glob": "*.md",
                        "output": "data/components"
                    },
                    {
                        "input": "packages/styles/stories",
                        "glob": "**/*.example.html",
                        "output": "data/examples"
                    },
                    {
                        "input": ".",
                        "glob": "CHANGELOG.md",
                        "output": "data"
                    }
                ]
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/dist/packages/mcp"],
            "cache": false,
            "dependsOn": ["build-tsc"],
            "options": {
                "cwd": "{workspaceRoot}",
                "command": "node packages/mcp/scripts/copy-generated-assets.mjs"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vitest packages/mcp/tests --run"
            }
        },
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx tsx packages/mcp/src/index.ts"
            }
        },
        "inspect": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx @modelcontextprotocol/inspector npx tsx packages/mcp/src/index.ts"
            }
        }
    }
}
